generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  name        String    
  email       String       @unique
  password    String

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Product {
  id          String   @id @default(cuid())

  name        String
  description String

  price       Decimal @db.Decimal(10,2)

  stock       Int

  imageUrl    String?

  deleted     Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}